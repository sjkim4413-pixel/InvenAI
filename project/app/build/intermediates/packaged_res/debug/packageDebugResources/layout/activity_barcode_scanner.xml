<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="#FFFFFF"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<ScrollView 
		android:id="@+id/r0gsv5sbpkqqk"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:background="@drawable/cr28b0f172a"
		android:paddingBottom="114dp">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/r7b8fyy8q5rg"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/rwpshzafubw"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:paddingVertical="11dp"
					android:paddingHorizontal="20dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/riqse14du1wg"
						android:textColor="#FFFFFF"
						android:textSize="14sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="14:30"
					/>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<ImageView
						android:id="@+id/r2dw5neub3vq"
						android:layout_width="72dp"
						android:layout_height="18dp"
						android:src="@android:drawable/star_big_on"
						android:scaleType="fitXY"
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rducz9epeqwo"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:background="#CC1E293B"
					android:paddingVertical="12dp"
					android:paddingHorizontal="20dp"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/r013u3uswm23no"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:orientation="vertical">
						<TextView
							android:id="@+id/rwgcb3ob304a"
							android:textColor="#FFFFFF"
							android:textSize="18sp"
							android:textStyle="bold"
							android:layout_marginBottom="2dp"
							android:layout_marginEnd="14dp"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="바코드/QR 스캔"
						/>
						<TextView
							android:id="@+id/rolgbqyiyb9b"
							android:textColor="#94A3B8"
							android:textSize="13sp"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="자동 인식 모드 활성화됨"
						/>
					</LinearLayout>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/rvhf4gydald"
						app:shapeAppearanceOverlay="@style/cr18"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:src="@android:drawable/star_big_on"
						android:scaleType="fitXY"
					/>
				</LinearLayout>
				<ImageView
					android:id="@+id/r59zx6vv10kf"
					android:layout_width="match_parent"
					android:layout_height="480dp"
					android:src="@android:drawable/star_big_on"
					android:scaleType="fitXY"
				/>
				<LinearLayout
					android:id="@+id/r7engj7ukvpw"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:paddingVertical="16dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/r7f8e1v2rbd8"
						android:textColor="#FFFFFF"
						android:textSize="14sp"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="바코드 또는 QR코드를 스캔 영역에 맞춰주세요."
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/r1d4feu5oq23"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:paddingVertical="8dp"
					android:paddingHorizontal="20dp"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/r34ewyb3xwz4"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center_horizontal"
						android:background="@drawable/cr100b0d9488"
						android:paddingVertical="12dp"
						android:layout_marginEnd="12dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<TextView
							android:id="@+id/ri9n0ew3nqa"
							android:textColor="#FFFFFF"
							android:textSize="14sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="바코드"
						/>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/ratq18nw1ps"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center_horizontal"
						android:background="@drawable/s94a3b8sw1cr100"
						android:paddingVertical="11dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<TextView
							android:id="@+id/rcp34gdlrln"
							android:textColor="#94A3B8"
							android:textSize="14sp"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="QR코드"
						/>
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rqlif5m9ncq"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:paddingVertical="20dp"
					android:paddingHorizontal="32dp"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/r1llh6arg7iy"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:background="@drawable/cr100bffffff1f"
						android:paddingVertical="8dp"
						android:paddingHorizontal="16dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="horizontal">
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/r59l3mzf1vkl"
							app:shapeAppearanceOverlay="@style/cr100"
							android:layout_width="18dp"
							android:layout_height="18dp"
							android:layout_marginEnd="8dp"
							android:src="@android:drawable/star_big_on"
							android:scaleType="fitXY"
						/>
						<TextView
							android:id="@+id/rugo98clv47p"
							android:textColor="#FFFFFF"
							android:textSize="13sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="플래시 켜기"
						/>
					</LinearLayout>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<LinearLayout
						android:id="@+id/rxq1d7hgy5c"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:background="@drawable/cr100bffffff1f"
						android:paddingVertical="8dp"
						android:paddingHorizontal="16dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="horizontal">
						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/r0276uwguq9bt"
							app:shapeAppearanceOverlay="@style/cr100"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:layout_marginEnd="6dp"
							android:src="@android:drawable/star_big_on"
							android:scaleType="fitXY"
						/>
						<TextView
							android:id="@+id/robivtxvzpo"
							android:textColor="#FFFFFF"
							android:textSize="13sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="직접 입력"
						/>
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rx27y19pvygr"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:paddingTop="8dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/rktyttb71dmm"
						android:textColor="#94A3B8"
						android:textSize="12sp"
						android:layout_marginBottom="20dp"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="스캔이 잘 안 되는 경우 직접 입력을 이용하세요."
					/>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
