<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="#FFFFFF"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<ScrollView 
		android:id="@+id/r9lam66r9wgl"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:background="@drawable/cr28b0f172a"
		android:paddingBottom="190dp">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/rc3w7cs849oo"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/rtqh0hooct1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:paddingVertical="11dp"
					android:paddingHorizontal="20dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/rxzt8klnw0o"
						android:textColor="#FFFFFF"
						android:textSize="14sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text=""
					/>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<ImageView
						android:id="@+id/rgsw0un4ycns"
						android:layout_width="72dp"
						android:layout_height="18dp"
						android:src="@android:drawable/star_big_on"
						android:scaleType="fitXY"
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/r6z8bdhp1ve2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:background="#CC1E293B"
					android:paddingVertical="12dp"
					android:paddingHorizontal="20dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/rdpaaa3td8zh"
						android:textColor="#FFFFFF"
						android:textSize="16sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="A구역 · A01 촬영 확인"
					/>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<LinearLayout
						android:id="@+id/rde617ktz7kt"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/cr100b0d9488"
						android:paddingVertical="4dp"
						android:paddingHorizontal="10dp"
						android:orientation="vertical">
						<TextView
							android:id="@+id/r2i6knqy0snm"
							android:textColor="#FFFFFF"
							android:textSize="12sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="1/5 촬영됨"
						/>
					</LinearLayout>
				</LinearLayout>
				<ImageView
					android:id="@+id/r3zlzs93haff"
					android:layout_width="match_parent"
					android:layout_height="480dp"
					android:src="@android:drawable/star_big_on"
					android:scaleType="fitXY"
				/>
				<LinearLayout
					android:id="@+id/rmxd6eay78vk"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="24dp"
					android:paddingBottom="12dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/rxj42qgng2r"
						android:textColor="#FFFFFF"
						android:textSize="16sp"
						android:textStyle="bold"
						android:layout_marginStart="42dp"
						android:layout_marginEnd="28dp"
						android:layout_height="wrap_content"
						android:layout_width="match_parent"
						android:layout_weight="1"
						android:gravity="center"
						android:text="사진을 확인해주세요."
					/>
					<TextView
						android:id="@+id/rvddhjx7h07s"
						android:textColor="#94A3B8"
						android:textSize="13sp"
						android:layout_marginEnd="24dp"
						android:layout_height="wrap_content"
						android:layout_width="match_parent"
						android:layout_weight="1"
						android:gravity="center"
						android:text="글자와 바코드가 선명하게 보일수록 AI 분석이 정확해집니다."
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/r3gi3f6o0wcm"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:background="#0F172A"
					android:padding="20dp"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/r9q20dzoqfq6"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center_horizontal"
						android:background="@drawable/sffffffsw1cr14bffffff1a"
						android:paddingVertical="17dp"
						android:layout_marginEnd="12dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<TextView
							android:id="@+id/raib2lmrlpgv"
							android:textColor="#FFFFFF"
							android:textSize="15sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="다시 촬영"
						/>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/r6r7tkf5i87c"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:gravity="center_horizontal"
						android:background="@drawable/cr14b0d9488"
						android:paddingVertical="17dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<TextView
							android:id="@+id/r1m8c094rv7"
							android:textColor="#FFFFFF"
							android:textSize="15sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="이 사진 사용"
						/>
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
