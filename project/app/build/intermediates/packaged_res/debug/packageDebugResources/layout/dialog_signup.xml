<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="신규 회원가입"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- 회사/사업장 코드 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회사/사업장 코드"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etSignupCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="예: ABC-001"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"
        android:background="@drawable/se2e8f0sw1cr12bffffff"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:inputType="text" />

    <!-- 아이디 / 사번 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="아이디 (사번)"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etSignupId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="사번 또는 아이디 입력"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"
        android:background="@drawable/se2e8f0sw1cr12bffffff"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:inputType="text" />

    <!-- 비밀번호 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etSignupPw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="비밀번호 입력"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"
        android:background="@drawable/se2e8f0sw1cr12bffffff"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:inputType="textPassword" />

    <!-- 비밀번호 확인 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 확인"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etSignupPwConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="비밀번호 재입력"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"
        android:background="@drawable/se2e8f0sw1cr12bffffff"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:inputType="textPassword" />

    <!-- 권한 / 역할 선택 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="작업 권한 선택"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/rgRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbQA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="검수자 (QA)"
            android:textColor="#0F172A"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbLoader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="적재자 (LOADER)"
            android:textColor="#0F172A" />
    </RadioGroup>

    <!-- 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelSignup"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="취소"
            android:textColor="#475569" />

        <Button
            android:id="@+id/btnSubmitSignup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#0D9488"
            android:text="회원가입"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>