<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="#FFFFFF"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<ScrollView 
		android:id="@+id/r7kqu3fik8ii"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:background="#FFFFFF">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/rf4i88i3wprv"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/cr28bf8fafc"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/r0yiuj7adb8x"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="255dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/red6ueez4sdl"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:paddingVertical="15dp"
						android:paddingHorizontal="12dp"
						android:visibility="gone"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/r3818i3swe67"
							android:textColor="#0F172A"
							android:textSize="14sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text=""
						/>
						<View
							android:layout_width="0dp"
							android:layout_height="0dp"
							android:layout_weight="1"
						 />
						<ImageView
							android:id="@+id/rowjrgnftxv"
							android:layout_width="72dp"
							android:layout_height="18dp"
							android:src="@android:drawable/star_big_on"
							android:scaleType="fitXY"
						/>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/rpfrzms7sq0f"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal"
						android:paddingTop="40dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/rk3b6e48iwx"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal"
							android:layout_marginBottom="36dp"
							android:layout_marginHorizontal="16dp"
							android:orientation="vertical">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/rrbh7yzzjhoo"
								app:shapeAppearanceOverlay="@style/cr18"
								android:layout_width="64dp"
								android:layout_height="64dp"
								android:layout_marginBottom="12dp"
								android:src="@android:drawable/star_big_on"
								android:scaleType="fitXY"
							/>
							<LinearLayout
								android:id="@+id/rpd5pzg65jga"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_horizontal"
								android:orientation="vertical">
								<TextView
									android:id="@+id/r2pnsmsgoyz9"
									android:textColor="#0F172A"
									android:textSize="24sp"
									android:textStyle="bold"
									android:layout_marginBottom="4dp"
									android:layout_height="wrap_content"
									android:layout_width="wrap_content"
									android:text="스마트 재고 AI"
								/>
								<TextView
									android:id="@+id/rsnz1cl9eyid"
									android:textColor="#475569"
									android:textSize="14sp"
									android:layout_height="wrap_content"
									android:layout_width="wrap_content"
									android:text="더 빠르고 정확한 창고 재고관리"
								/>
							</LinearLayout>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/rqpyt0imzrps"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="36dp"
							android:layout_marginHorizontal="16dp"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/rkrlmrp9qeu"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginBottom="16dp"
								android:orientation="vertical">
								<TextView
									android:id="@+id/rkhiolkqg84b"
									android:textColor="#475569"
									android:textSize="13sp"
									android:textStyle="bold"
									android:layout_marginBottom="6dp"
									android:layout_height="wrap_content"
									android:layout_width="wrap_content"
									android:text="회사/사업장 코드"
								/>
								<EditText
									android:inputType="text"
									android:privateImeOptions="defaultInputmode=korean"
									android:hint="ABC-001"
									android:id="@+id/rmm3ibea01dh"
									android:textColor="#0F172A"
									android:textColorHint="#94A3B8"
									android:textSize="14sp"
									android:focusable="true"
									android:focusableInTouchMode="true"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:background="@drawable/se2e8f0sw1cr12bffffff"
									android:paddingVertical="15dp"
									android:paddingHorizontal="16dp"
								/>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/rug83pu1osl"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginBottom="16dp"
								android:orientation="vertical">
								<TextView
									android:id="@+id/rk8qpq5wylk"
									android:textColor="#475569"
									android:textSize="13sp"
									android:textStyle="bold"
									android:layout_marginBottom="6dp"
									android:layout_height="wrap_content"
									android:layout_width="wrap_content"
									android:text="아이디"
								/>
								<EditText
									android:inputType="text"
									android:privateImeOptions="defaultInputmode=korean"
									android:hint="사번 또는 아이디 입력"
									android:id="@+id/rtduz0dht8w"
									android:textColor="#0F172A"
									android:textColorHint="#94A3B8"
									android:textSize="14sp"
									android:focusable="true"
									android:focusableInTouchMode="true"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:background="@drawable/se2e8f0sw1cr12bffffff"
									android:paddingVertical="15dp"
									android:paddingHorizontal="16dp"
								/>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/rj36po9bzuh"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical">
								<TextView
									android:id="@+id/rnse1ieidy4"
									android:textColor="#475569"
									android:textSize="13sp"
									android:textStyle="bold"
									android:layout_marginBottom="6dp"
									android:layout_height="wrap_content"
									android:layout_width="wrap_content"
									android:text="비밀번호"
								/>
								<LinearLayout
									android:id="@+id/rv61zbvblrd"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:gravity="center_vertical"
									android:background="@drawable/se2e8f0sw1cr12bffffff"
									android:paddingVertical="14dp"
									android:paddingHorizontal="16dp"
									android:orientation="horizontal">
									<EditText
										android:id="@+id/r5suocwfrhze"
										android:inputType="textPassword"
										android:hint="비밀번호 입력"
										android:textColor="#0F172A"
										android:textColorHint="#94A3B8"
										android:textSize="14sp"
										android:background="@null"
										android:layout_width="0dp"
										android:layout_height="wrap_content"
										android:layout_weight="1"
									/>
									<com.google.android.material.imageview.ShapeableImageView
										android:id="@+id/rzrod1igfm8o"
										app:shapeAppearanceOverlay="@style/cr12"
										android:layout_width="20dp"
										android:layout_height="20dp"
										android:src="@android:drawable/star_big_on"
										android:scaleType="fitXY"
									/>
								</LinearLayout>
							</LinearLayout>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/rm7oakdg802"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:layout_marginHorizontal="16dp"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/rlk8j1kj2j19"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center_horizontal"
								android:background="@drawable/cr14b0d9488"
								android:paddingVertical="16dp"
								android:layout_marginBottom="20dp"
								android:elevation="12dp"
								android:clickable="true"
								android:focusable="true"
								android:orientation="vertical">
								<TextView
									android:id="@+id/rffbit4pq0uw"
									android:textColor="#FFFFFF"
									android:textSize="16sp"
									android:textStyle="bold"
									android:layout_height="wrap_content"
									android:layout_width="wrap_content"
									android:text="로그인"
								/>
							</LinearLayout>
							<LinearLayout
								android:id="@+id/rthzrdhslkaa"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:gravity="center"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/r1xmeb2jgdkd"
									android:textColor="#475569"
									android:textSize="13sp"
									android:layout_marginEnd="10dp"
									android:layout_height="wrap_content"
									android:layout_width="wrap_content"
									android:text="로그인에 문제가 있나요?"
								/>
								<TextView
									android:id="@+id/rau6xo31lv7j"
									android:textColor="#0D9488"
									android:textSize="13sp"
									android:textStyle="bold"
									android:layout_height="wrap_content"
									android:layout_width="wrap_content"
									android:text="관리자에게 문의"
								/>
							</LinearLayout>
						</LinearLayout>
						<TextView
							android:id="@+id/rini482f9v4"
							android:textColor="#0D9488"
							android:textSize="13sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="회원가입"
						/>
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rakg5x7ipzih"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:paddingBottom="15dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/r5whdlnw7bka"
						android:textColor="#94A3B8"
						android:textSize="12sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="v2.0"
					/>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
