<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="#FFFFFF"
	android:clipChildren="false"
	android:clipToPadding="false"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<ScrollView 
		android:clipChildren="false"
		android:clipToPadding="false"
		android:id="@+id/rl0xhn50sar"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:background="@drawable/cr28bf8fafc">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipChildren="false"
			android:clipToPadding="false"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/rovgswgv9cz7"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="24dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/rv98rsoobkul"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:paddingVertical="11dp"
					android:paddingHorizontal="20dp"
					android:visibility="gone"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/rvy60cbl4ju"
						android:textColor="#0F172A"
						android:textSize="14sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text=""
					/>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<ImageView
						android:id="@+id/rvr5zkk72xae"
						android:layout_width="72dp"
						android:layout_height="18dp"
						android:src="@android:drawable/star_big_on"
						android:scaleType="fitXY"
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rzgrnac0z15k"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:background="#FFFFFF"
					android:paddingVertical="8dp"
					android:paddingLeft="16dp"
					android:orientation="horizontal">
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/r4dlso48svyt"
						app:shapeAppearanceOverlay="@style/cr20"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:layout_marginEnd="8dp"
						android:src="@drawable/ic_inven_back"
						android:scaleType="fitCenter"
					/>
					<TextView
						android:id="@+id/r5v82vnxdvbw"
						android:textColor="#0F172A"
						android:textSize="18sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="이상 재고 신속 처리"
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rqmey1v7zsco"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:background="#FFFFFF"
					android:paddingVertical="12dp"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/rgaffdocilc"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/se2e8f0sw1cr100bf8fafc"
						android:paddingVertical="8dp"
						android:paddingHorizontal="12dp"
						android:layout_marginStart="12dp"
						android:layout_marginEnd="6dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<TextView
							android:id="@+id/rm6h0exv82s"
							android:textColor="#475569"
							android:textSize="13sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="전체"
						/>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/rytuded4x8wi"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/cr100b0d9488"
						android:paddingVertical="8dp"
						android:paddingHorizontal="12dp"
						android:layout_marginEnd="6dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<TextView
							android:id="@+id/rqs6bj17x36p"
							android:textColor="#FFFFFF"
							android:textSize="13sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="확인 필요"
						/>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/ri2fvq4nz5o"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/se2e8f0sw1cr100bf8fafc"
						android:paddingVertical="8dp"
						android:paddingHorizontal="12dp"
						android:layout_marginEnd="6dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<TextView
							android:id="@+id/raasbhdamjlq"
							android:textColor="#475569"
							android:textSize="13sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="확인 중"
						/>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/rdhlujjv2zdp"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/se2e8f0sw1cr100bf8fafc"
						android:paddingVertical="8dp"
						android:paddingHorizontal="12dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<TextView
							android:id="@+id/rpkc97qvmlh"
							android:textColor="#475569"
							android:textSize="13sp"
							android:textStyle="bold"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="처리 완료"
						/>
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rj0lzllza8c"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="12dp"
					android:orientation="vertical">
</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
    <LinearLayout
        android:id="@+id/warehouseBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
