<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- 헤더 배지 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 F-06 오적재 실시간 푸시 알림"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginBottom="16dp" />

    <!-- 위치 정보 -->
    <TextView
        android:id="@+id/tvAlertLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 발생 위치: B구역 R05-3층"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- 정상 ID vs 오적재 ID -->
    <TextView
        android:id="@+id/tvAlertItemInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="정상 ID: M-100  |  오적재 ID: BT-200"
        android:textColor="#475569"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <!-- 현장 사진 이미지 -->
    <ImageView
        android:id="@+id/ivAlertCroppedPhoto"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:background="#F1F5F9"
        android:src="@android:drawable/ic_menu_camera"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="시정 조치 후 아래 [수정 완료 보고] 버튼을 누르면 검수자에게 '재검증 대기' 상태로 회신됩니다."
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnF06Cancel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="닫기"
            android:textColor="#475569" />

        <Button
            android:id="@+id/btnF06Complete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#0D9488"
            android:text="수정 완료 보고 (재검증 대기)"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>