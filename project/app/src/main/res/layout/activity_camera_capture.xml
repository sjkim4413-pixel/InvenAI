<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="#FFFFFF"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<ScrollView 
		android:id="@+id/r1uby732j5vd"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:background="@drawable/cr28b0f172a"
		android:paddingBottom="131dp">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/rf2xed3iz0sl"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/r35ixmqufnzv"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:paddingVertical="11dp"
					android:paddingHorizontal="20dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/rp16f8n48xa"
						android:textColor="#FFFFFF"
						android:textSize="14sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text=""
					/>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<ImageView
						android:id="@+id/rpnrbwdb3cz"
						android:layout_width="72dp"
						android:layout_height="18dp"
						android:src="@android:drawable/star_big_on"
						android:scaleType="fitXY"
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/r3x0cqqnduow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:background="#CC1E293B"
					android:paddingVertical="12dp"
					android:paddingHorizontal="20dp"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/r2vhl7tqnn7f"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:orientation="vertical">
						<TextView
							android:id="@+id/rwg28kkygabe"
							android:textColor="#FFFFFF"
							android:textSize="16sp"
							android:textStyle="bold"
							android:layout_marginBottom="2dp"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="A구역 · A01~A05"
						/>
						<TextView
							android:id="@+id/rzwrxwc424r"
							android:textColor="#94A3B8"
							android:textSize="13sp"
							android:layout_marginEnd="40dp"
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:text="진행율: 촬영 0/5"
						/>
					</LinearLayout>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/rv7b2iultky"
						app:shapeAppearanceOverlay="@style/cr18"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:src="@android:drawable/star_big_on"
						android:scaleType="fitXY"
					/>
				</LinearLayout>
				<ImageView
					android:id="@+id/r9hxihhz6vy9"
					android:layout_width="match_parent"
					android:layout_height="480dp"
					android:src="@android:drawable/star_big_on"
					android:scaleType="fitXY"
				/>
				<LinearLayout
					android:id="@+id/rkwzthdfuf9"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:paddingVertical="12dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/re9kf19blhpt"
						android:textColor="#FFFFFF"
						android:textSize="14sp"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="랙 전체가 가이드 안에 들어오도록 촬영해주세요."
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rrq4b7yuw7fc"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:background="#1E293B"
					android:paddingVertical="12dp"
					android:paddingHorizontal="16dp"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/rxghd0s80pq"
						android:textColor="#10B981"
						android:textSize="13sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="✓ 밝기 양호"
					/>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<TextView
						android:id="@+id/r7jlgfrtuz0p"
						android:textColor="#10B981"
						android:textSize="13sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="✓ 초점 양호"
					/>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<TextView
						android:id="@+id/rwhpzb0nn3qh"
						android:textColor="#10B981"
						android:textSize="13sp"
						android:textStyle="bold"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:text="✓ 랙 감지됨"
					/>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/rzi4m0voq7vb"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:background="#0F172A"
					android:paddingVertical="20dp"
					android:paddingHorizontal="40dp"
					android:orientation="horizontal">
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/rv1tgwikyid9"
						app:shapeAppearanceOverlay="@style/cr24"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:src="@android:drawable/star_big_on"
						android:scaleType="fitXY"
					/>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<LinearLayout
						android:id="@+id/rmhc5kxfqz9h"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/cr42b0d948840"
						android:padding="9dp"
						android:clickable="true"
						android:focusable="true"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/r8xpb516ybwu"
							android:layout_width="66dp"
							android:layout_height="66dp"
							android:background="@drawable/cr33bffffff"
							android:orientation="vertical">
						</LinearLayout>
					</LinearLayout>
					<View
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1"
					 />
					<LinearLayout
						android:id="@+id/rzw18ewq9upq"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:orientation="vertical">
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
